<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" 
        xmlns:tizen="http://tizen.org/ns/widgets" 
        id="http://developer.samsung.com/tizen/FastTVLauncher" 
        version="1.1.0" 
        viewmodes="maximized">

    <tizen:application id="xY6K9b1Lau.FastTVLauncher" 
                       package="xY6K9b1Lau" 
                       required_version="2.3"/>

    <content src="index.html"/>

    <feature name="http://tizen.org/feature/screen.size.all"/>

    <icon src="icon.png"/>
    <name>Fast TV Launcher</name>
    <description>Launcher Cinemático e Ultraleve para Samsung Smart TV</description>

    <tizen:profile name="tv-samsung"/>

    <!-- Configurações para inicialização contínua e Multitasking -->
    <tizen:setting screen-orientation="landscape" 
                   context-menu="enable" 
                   background-support="enable" 
                   encryption="disable" 
                   install-location="auto"/>

    <!-- Metadados de Inicialização Rápida e Multitarefa -->
    <tizen:metadata key="http://samsung.com/tv/metadata/multitasking.support" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/use.ime" value="true"/>

    <!-- Permissões Essenciais da TV -->
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>

    <access origin="*" subdomains="true"/>
</widget>
